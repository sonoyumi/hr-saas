# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Случайная строка для подписи входа в кабинет: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Ключ шифрования токенов ботов компаний: hr-saas gen-key. ПОТЕРЯ КЛЮЧА = переподключить все боты.
MASTER_KEY=

# Публичный адрес сервиса. Telegram присылает вебхуки только на https://
PUBLIC_URL=https://hr.example.com
HOST=127.0.0.1
PORT=8098
# Cookie только по HTTPS (на сервере — true)
COOKIE_SECURE=false

DATABASE_PATH=data/hr.db
PLATFORM_NAME=HR Screening

# Оценка открытых ответов: off — ключевые слова; mock — демо без ИИ; claude — Claude API (тарифы Pro и Business)
AI_MODE=off
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
